# URL publique du site
NEXT_PUBLIC_SITE_URL=https://votre-domaine.com

# Identifiant Google Analytics, uniquement en production
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Numéro WhatsApp au format international, sans plus ni espaces
NEXT_PUBLIC_WHATSAPP_NUMBER=22890000000

# Sanity, à remplir en Phase 2
NEXT_PUBLIC_SANITY_PROJECT_ID=votre-projet
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_REVALIDATE_SECRET=votre-secret

# Indexation : false en aperçu, true au lancement
NEXT_PUBLIC_INDEXING=false

# Affichage des prix : false pour masquer les prix, true pour les afficher
NEXT_PUBLIC_SHOW_PRICES=false
